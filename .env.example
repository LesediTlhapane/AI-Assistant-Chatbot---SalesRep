# Copy this file to .env.local or .env and fill in your real values before running locally.
# Never commit real secrets. Keep this file checked in only with placeholders.

# Server-side Groq configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Server runtime settings
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001
